{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.7.6",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://auroraforchatgpt.tnemoroccan.workers.dev/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aurora-for-chatgpt-librewolf@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "personalCommunications",
          "technicalAndInteraction"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "commands": {
    "toggle-visibility": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle Focus Mode (Visibility)"
    },
    "toggle-blur": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Toggle Blur (Streamer Mode)"
    }
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "data-masking.js",
        "token-counter.js",
        "modules/message-queue.js",
        "modules/aurora/namespace.js",
        "modules/aurora/config.js",
        "modules/aurora/utils.js",
        "modules/aurora/i18n.js",
        "modules/aurora/fonts.js",
        "modules/aurora/contrast.js",
        "modules/aurora/background.js",
        "modules/aurora/upgrade.js",
        "modules/aurora/glass.js",
        "modules/aurora/default-model.js",
        "modules/aurora/quick-settings.js",
        "modules/aurora/root-flags.js",
        "modules/aurora/audio.js",
        "modules/aurora/masking.js",
        "modules/aurora/token-counter-bridge.js",
        "modules/aurora/welcome.js",
        "modules/aurora/queue.js",
        "modules/aurora/disable.js",
        "modules/aurora/orchestrator.js",
        "modules/aurora/init.js",
        "content.js"
      ],
      "css": [
        "styles.css",
        "new-features.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/grok-4.webp",
        "_locales/*/messages.json",
        "vendor/tiktoken-lite/*",
        "vendor/tiktoken-lite/encoders/*"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
